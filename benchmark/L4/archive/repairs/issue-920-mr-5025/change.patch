+bool CVPipelineImpl::hasCrossItemBufferFeedbackCycle() {
+  if (worklist.size() < 2)
+    return false;
+
+  // Identity of a local staging buffer. Work items may each hold their own
+  // `memref.alloc` for the same physical buffer, so the tightly-coupled-buffer
+  // id decides identity whenever one is attached; otherwise the traced
+  // allocation is the identity. For buffers without an id, tracking is limited
+  // to allocations inside the loop: GM traffic is covered by the separation
+  // checks in markOutputs. A tightly-coupled buffer is always local staging,
+  // even when `hivm-hoist-tightly-coupled-alloc` moved its allocation out of
+  // the loop, so it must stay tracked regardless of where the alloc lives.
+  using BufferKey = std::pair<int64_t, Value>;
+
+  auto getTcbId = [](Value value) -> std::optional<int64_t> {
+    std::optional<Operation *> mark = getTightlyCoupledMark(value);
+    if (!mark)
+      return std::nullopt;
+    auto attr = dyn_cast_or_null<HIVMTightlyCoupledBufferAttr>(
+        (*mark)->getAttr(HIVMTightlyCoupledBufferAttr::name));
+    if (!attr || !attr.getId().has_value())
+      return std::nullopt;
+    return attr.getId().value();
+  };
+
+  auto resolveBuffer = [&](Value value) -> std::optional<BufferKey> {
+    int64_t tcbId = -1;
+    Value current = value;
+    while (current) {
+      if (auto id = getTcbId(current))
+        tcbId = *id;
+      Operation *defining = current.getDefiningOp();
+      if (!defining)
+        break;
+      Value next = getTightlyCoupledViewSource(defining);
+      if (!next)
+        break;
+      current = next;
+    }
+    // Check the id before the allocation: hoisting can put a tightly-coupled
+    // alloc outside the loop without making it GM traffic.
+    if (tcbId >= 0)
+      return BufferKey{tcbId, Value()};
+    auto alloc = current.getDefiningOp<memref::AllocOp>();
+    if (!alloc || !pipelineLoop->isAncestor(alloc))
+      return std::nullopt;
+    return BufferKey{-1, current};
+  };
+
+  DenseMap<BufferKey, unsigned> keyIds;
+  SmallVector<DenseSet<unsigned>> readers;
+  SmallVector<DenseSet<unsigned>> writers;
+  auto recordAccess = [&](Value value, unsigned itemIdx, bool isWrite) {
+    std::optional<BufferKey> key = resolveBuffer(value);
+    if (!key)
+      return;
+    auto [it, inserted] = keyIds.try_emplace(*key, keyIds.size());
+    if (inserted) {
+      readers.emplace_back();
+      writers.emplace_back();
+    }
+    (isWrite ? writers : readers)[it->second].insert(itemIdx);
+  };
+
+  Block *body = pipelineLoop.getBody();
+  DenseMap<WorkItem *, unsigned> itemIndices;
+  for (unsigned itemIdx = 0; itemIdx < worklist.size(); ++itemIdx)
+    itemIndices[worklist[itemIdx].get()] = itemIdx;
+
+  // Owners of an operation, inherited from the nearest mapped ancestor.
+  auto ownersOf = [&](Operation *op) -> ArrayRef<WorkItem *> {
+    for (Operation *current = op; current; current = current->getParentOp()) {
+      auto it = opToWorkItemMap.find(current);
+      if (it != opToWorkItemMap.end())
+        return it->second;
+      if (current->getBlock() == body)
+        break;
+    }
+    return {};
+  };
+
+  // Buffer-level effects: destination-style inits are written, every other
+  // operand is read. Reads are recorded for every owner because a shared
+  // operation only fans out; a write is recorded for the single item the
+  // operation is migrated to, otherwise one shared operation (a lazy-load clone
+  // source, for instance) would look like a write from both sides of a plain
+  // fan-out and fake a feedback cycle.
+  for (Operation &top : *body) {
+    top.walk([&](Operation *nested) {
+      ArrayRef<WorkItem *> owners = ownersOf(nested);
+      if (owners.empty())
+        return;
+      unsigned writer = itemIndices.lookup(owners.front());
+      if (auto dps = dyn_cast<DestinationStyleOpInterface>(nested)) {
+        for (OpOperand &operand : nested->getOpOperands()) {
+          if (dps.isDpsInit(&operand)) {
+            recordAccess(operand.get(), writer, /*isWrite=*/true);
+            continue;
+          }
+          for (WorkItem *owner : owners)
+            recordAccess(operand.get(), itemIndices.lookup(owner),
+                         /*isWrite=*/false);
+        }
+        return;
+      }
+      for (Value operand : nested->getOperands())
+        for (WorkItem *owner : owners)
+          recordAccess(operand, itemIndices.lookup(owner), /*isWrite=*/false);
+    });
+  }
+
+  unsigned numItems = static_cast<unsigned>(worklist.size());
+  SmallVector<DenseSet<unsigned>> successors(numItems);
+  for (unsigned keyId = 0, e = readers.size(); keyId < e; ++keyId)
+    for (unsigned writer : writers[keyId])
+      for (unsigned reader : readers[keyId])
+        if (writer != reader)
+          successors[writer].insert(reader);
+
+  // Depth-first search for a cycle in the work-item dependence graph.
+  SmallVector<int> state(numItems, 0); // 0 = unvisited, 1 = on path, 2 = done
+  std::function<bool(unsigned)> visit = [&](unsigned node) {
+    state[node] = 1;
+    for (unsigned successor : successors[node]) {
+      if (state[successor] == 1)
+        return true;
+      if (state[successor] == 0 && visit(successor))
+        return true;
+    }
+    state[node] = 2;
+    return false;
+  };
+  for (unsigned itemIdx = 0; itemIdx < numItems; ++itemIdx)
+    if (state[itemIdx] == 0 && visit(itemIdx))
+      return true;
+  return false;
+}

+  bool residentIf =
+      isa<scf::IfOp>(source.getOwner()) && isResultRemainInL0C(source);
+  if (auto loop = dyn_cast<scf::ForOp>(user); loop && residentIf)
+    return !isLoopCarriedMatmulInit(loop, use);

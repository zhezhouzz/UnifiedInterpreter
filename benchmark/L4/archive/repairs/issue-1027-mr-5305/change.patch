+void markL0CBoundMatmulResults(annotation::MarkOp mark) {
+  auto ifOp = mark.getSrc().getDefiningOp<scf::IfOp>();
+  if (!ifOp || !mark.isAnnotatedByDynamicAttr(memref::kBindBufferAttrName))
+    return;
+  Value buffer = mark.getDynamicAttrValue(memref::kBindBufferAttrName);
+  if (!buffer.getDefiningOp<memref::AllocOp>() ||
+      getOptionalHIVMAddressSpace(buffer.getType()) != AddressSpace::L0C)
+    return;
+
+  auto result = cast<OpResult>(mark.getSrc());
+  auto getMatmulResult = [&](scf::YieldOp yield) -> OpResult {
+    Value value = yield.getOperand(result.getResultNumber());
+    auto matmul = value.getDefiningOp<LocalMatmulLikeOpInterface>();
+    if (!matmul || matmul->getBlock() != yield->getBlock())
+      return {};
+    return cast<OpResult>(value);
+  };
+  OpResult thenResult = getMatmulResult(ifOp.thenYield());
+  OpResult elseResult = getMatmulResult(ifOp.elseYield());
+  if (!thenResult || !elseResult)
+    return;
+
+  Builder builder(mark.getContext());
+  for (OpResult resident : {thenResult, elseResult, result}) {
+    if (!isResultRemainInL0C(resident))
+      utils::insertIntegerAttrToArrayAttr(resident.getOwner(),
+                                          RemainInL0CAttr::name,
+                                          resident.getResultNumber(), builder);
+  }
+}

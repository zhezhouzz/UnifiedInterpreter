+  if (isa<LocalMatmulLikeOpInterface>(user) &&
+      cast<DestinationStyleOpInterface>(user).isDpsInit(&use) &&
+      (residentIf || source.getOwner()->getName() == user->getName()))
+    return false;
+  return !(shouldKeepYieldInL0C(use) && isRemainInL0c(use));

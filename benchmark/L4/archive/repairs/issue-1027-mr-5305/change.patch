+static bool isLoopCarriedMatmulInit(scf::ForOp loop, OpOperand &init) {
+  BlockArgument iterArg = loop.getTiedLoopRegionIterArg(&init);
+  if (!iterArg || !iterArg.hasOneUse() ||
+      !isResultRemainInL0C(loop.getTiedLoopResult(iterArg)))

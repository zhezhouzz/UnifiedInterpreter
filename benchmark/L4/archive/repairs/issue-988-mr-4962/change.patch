@@ -94,6 +94,64 @@ inline bool isNativeMmadMxTarget(Operation *anchor) {
           .build());
 }
 
+// Mixed-precision MMAD needs the dav-920r1 `mad` overloads, so only that
+// architecture can accept A and B with distinct element types.
+inline bool supportsHeteroMmadL1(Operation *anchor) {
+  auto architecture = mmadArchitecture(anchor);
+  return architecture &&
+         *architecture == bishengir::npu::NPUArchitectureKind::kDav920R1;
+}
+
+// The dav-920r1 pair table: f16/bf16 x fp8-e4m3, f16/bf16 x int8, the two
+// mixed fp8 orders, and the packed 4-bit pairs (f16/bf16/int8) x int4. The
+// Dav_920R1 profile still carries the Dav920R1AnyMmad
+// AnyValue catch-all, so until it gains precise rows, this table is the single
+// source of truth for mixed-precision mmadL1: op verification and
+// library-symbol naming must both call it.
+inline bool isNativeHeteroMmadL1(Operation *anchor, Type aElementType,
+                                 Type bElementType) {
+  if (!supportsHeteroMmadL1(anchor))
+    return false;
+  Type f16 = Float16Type::get(anchor->getContext());
+  Type bf16 = BFloat16Type::get(anchor->getContext());
+  Type f8e4 = Float8E4M3FNType::get(anchor->getContext());
+  Type f8e5 = Float8E5M2Type::get(anchor->getContext());
+  Type i8 = IntegerType::get(anchor->getContext(), 8);
+  Type i4 = IntegerType::get(anchor->getContext(), 4);
+  bool aF16Like = aElementType == f16 || aElementType == bf16;
+  return (aF16Like && (bElementType == f8e4 || bElementType == i8)) ||
+         (aElementType == f8e4 && bElementType == f8e5) ||
+         (aElementType == f8e5 && bElementType == f8e4) ||
+         ((aF16Like || aElementType == i8) && bElementType == i4);
+}
+
+// Packed 4-bit MMAD needs the dav-920r1 `mad_*s4` overloads. It is an
+// independent capability from mixed-precision MMAD; the architecture lists
+// merely coincide today.
+inline bool supportsPackedS4MmadL1(Operation *anchor) {
+  auto architecture = mmadArchitecture(anchor);
+  return architecture &&
+         *architecture == bishengir::npu::NPUArchitectureKind::kDav920R1;
+}
+
+// s4 weights ride in a packed 4-bit int4b_t buffer:
+// f16/bf16 x s4 -> f32 and s8 x s4 -> i32. Shares the pair-table caveat above.
+inline bool isNativePackedS4MmadL1(Operation *anchor, Type aElementType,
+                                   Type bElementType, Type cElementType) {
+  if (!supportsPackedS4MmadL1(anchor))
+    return false;
+  Type f16 = Float16Type::get(anchor->getContext());
+  Type bf16 = BFloat16Type::get(anchor->getContext());
+  Type i8 = IntegerType::get(anchor->getContext(), 8);
+  Type i4 = IntegerType::get(anchor->getContext(), 4);
+  bool aF16Like = aElementType == f16 || aElementType == bf16;
+  return bElementType == i4 &&
+         ((aF16Like &&
+           cElementType == Float32Type::get(anchor->getContext())) ||
+          (aElementType == i8 &&
+           cElementType == IntegerType::get(anchor->getContext(), 32)));
+}
+
 } // namespace hivm
 } // namespace mlir
 

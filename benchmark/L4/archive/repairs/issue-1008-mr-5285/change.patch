+std::optional<hfusion::PrintOp::Properties>
+hfusion::getTritonPrintProperties(func::FuncOp callee) {
+  static const llvm::Regex printSymbol(PrintOp::tritonAdapterSymbolPattern);
+  if (!callee || !callee.isExternal() ||
+      callee.getFunctionType().getNumResults() ||
+      !printSymbol.match(callee.getSymName()))
+    return std::nullopt;
+
+  PrintOp::Properties properties;
+  for (NamedAttribute attr : callee->getDiscardableAttrs())
+    PrintOp::setInherentAttr(properties, attr.getName(), attr.getValue());
+  if (!properties.prefix || !properties.hex)
+    return std::nullopt;
+  return properties;
+}

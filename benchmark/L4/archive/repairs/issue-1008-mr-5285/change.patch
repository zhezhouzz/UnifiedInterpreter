+void BiShengIRCompileMainConfig::disableUnsupportedLayoutOptimization(
+    mlir::ModuleOp module) {
+  if (!getEnableLayoutOptimization())
+    return;
+  mlir::SymbolTableCollection symbols;
+  auto walk = module.walk<mlir::WalkOrder::PreOrder>([&](mlir::Operation *op) {
+    if (isa<mlir::linalg::BatchMatmulOp, mlir::scope::ScopeOp,
+            mlir::hfusion::PrintOp>(op))
+      return mlir::WalkResult::interrupt();
+#if BISHENGIR_ENABLE_TRITON_COMPILE
+    if (isa<mlir::triton::PrintOp>(op))
+      return mlir::WalkResult::interrupt();
+#endif
+    if (auto call = dyn_cast<mlir::func::CallOp>(op)) {
+      auto callee = symbols.lookupNearestSymbolFrom<mlir::func::FuncOp>(
+          call, call.getCalleeAttr());
+      if (mlir::hfusion::getTritonPrintProperties(callee))
+        return mlir::WalkResult::interrupt();
+    }
+    return mlir::WalkResult::advance();
+  });
+  if (walk.wasInterrupted())
+    setEnableLayoutOptimization(false);
+}

+        castOp->getNumResults() == 1) {
+      auto srcType = dyn_cast<VectorType>(castOp->getOperand(0).getType());
+      auto dstType = dyn_cast<VectorType>(mask.getType());
+      if (!srcType || !dstType || srcType.isScalable() ||

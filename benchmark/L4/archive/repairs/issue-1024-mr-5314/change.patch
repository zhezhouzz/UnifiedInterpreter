+// favor of the member form. Keep a single compat shim so the rank-1 strided
+// store path builds under both configurations.
+static LogicalResult getStridesAndOffsetCompat(MemRefType memrefTy,
+                                               SmallVectorImpl<int64_t> &strides,
+                                               int64_t &offset) {
+#ifndef __LLVM_MAJOR_VERSION_22_COMPATIBLE__
+  return getStridesAndOffset(memrefTy, strides, offset);
+#else
+  auto [s, o] = memrefTy.getStridesAndOffset();
+  strides.assign(s.begin(), s.end());
+  offset = o;
+  return success();
+#endif

+// small runtime-strided buffers produced by bufferization (e.g. the i64->i32
+// library-ABI cast). We intervene only for the statically non-contiguous case
+// the masked store provably flattens.
+static bool isRankOneStaticStridedStore(vector::TransferWriteOp op) {
+  auto type = dyn_cast<MemRefType>(op.getSource().getType());
+  if (!type || type.getRank() != 1)
+    return false;

+  // CHECK-NEXT: "hivm.intr.hivm.WAIT.INTRA.BLOCKI.mode"() <{pipe = 0 : i64, sync_id = 17 : i64}>
+  // CHECK-NEXT: "hivm.intr.hivm.WAIT.INTRA.BLOCKI.mode"() <{pipe = 0 : i64, sync_id = 1 : i64}>

+  %c16 = arith.constant 16 : index
+  %c64 = arith.constant 64 : index
+  %cst = arith.constant 0.000000e+00 : f32
+  %empty = tensor.empty() : tensor<16x16xf32>
+  %zero = hivm.hir.vbrc ins(%cst : f32) outs(%empty : tensor<16x16xf32>)
+      -> tensor<16x16xf32>

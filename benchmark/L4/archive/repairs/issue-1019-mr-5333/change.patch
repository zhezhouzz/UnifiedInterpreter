diff --git a/bishengir/lib/Tools/hivmc/Utility.cpp b/bishengir/lib/Tools/hivmc/Utility.cpp
index 0a7fcfc87..acfdcdfaf 100644
--- a/bishengir/lib/Tools/hivmc/Utility.cpp

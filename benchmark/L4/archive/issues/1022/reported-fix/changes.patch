 namespace {
 
+// Follow local views. Other uses must consume the buffer without forwarding
+// its address. This bounds the lifetime of a yielded allocation to one
+// backedge.
+static bool collectLoopBufferUses(Value value, OpOperand *returned,
+                                  SmallVectorImpl<OpOperand *> &accesses) {
+  SetVector<Value> views;
+  views.insert(value);
+  for (unsigned i = 0; i < views.size(); ++i) {
+    for (OpOperand &use : views[i].getUses()) {
+      Operation *user = use.getOwner();
+      if (&use == returned || isa<annotation::MarkOp>(user))
+        continue;
+      if (auto view = dyn_cast<ViewLikeOpInterface>(user)) {
+        views.insert(view->getResult(0));
+        continue;
+      }
+      auto store = dyn_cast<memref::StoreOp>(user);
+      if (isa<memref::LoadOp>(user) ||
+          (store && store.getMemRef() == use.get()) ||
+          ((isa<DestinationStyleOpInterface>(user) || hivm::isVFCall(user)) &&
+           user->getNumResults() == 0)) {
+        accesses.push_back(&use);
+        continue;
+      }
+      return false;
+    }
+  }
+  return true;
+}
+
+// A caller can still observe an initial allocation through another reference.
+// Only reuse it for the copy at the backedge when every other use precedes the
+// loop, including through views.
+static bool canReuseLoopInit(scf::ForOp loop, OpOperand &init) {
+  if (!init.get().getDefiningOp<memref::AllocOp>())
+    return false;
+  SmallVector<OpOperand *> accesses;
+  if (!collectLoopBufferUses(init.get(), &init, accesses))
+    return false;
+  return llvm::all_of(accesses, [&](OpOperand *use) {
+    Operation *user = loop->getBlock()->findAncestorOpInBlock(*use->getOwner());
+    return user && user != loop && user->isBeforeInBlock(loop);
+  });
+}
+
+// A scope executes its body exactly once. Compare operations in the common
+// block through scope boundaries, without assuming execution of other regions.
+static bool precedesInScopes(Operation *writer, Operation *reader) {
+  auto parentScope = [](Operation *op) -> Operation * {
+    return dyn_cast_or_null<scope::ScopeOp>(op->getParentOp());
+  };
+  for (auto *write = writer; write; write = parentScope(write))
+    for (auto *read = reader; read; read = parentScope(read))
+      if (write->getBlock() == read->getBlock())
+        return write != read && write->isBeforeInBlock(read);
+  return false;
+}
+
+static void preserveLoopCarry(scf::ForOp loop, OpOperand &yield,
+                              BlockArgument incoming, OpOperand &init) {
+  OpOperand *returned = &yield;
+  while (auto result = dyn_cast<OpResult>(returned->get())) {
+    auto scope = dyn_cast<scope::ScopeOp>(result.getOwner());
+    if (!scope)
+      break;
+    if (!result.hasOneUse() || scope->getNextNode() != returned->getOwner())
+      return;
+    returned = &scope.getBody()->getTerminator()->getOpOperand(
+        result.getResultNumber());
+  }
+
+  auto alloc = returned->get().getDefiningOp<memref::AllocOp>();
+  if (!alloc || alloc->getBlock() != returned->getOwner()->getBlock() ||
+      !alloc.getType().hasStaticShape() ||
+      !alloc.getType().getLayout().isIdentity())
+    return;
+  auto space = GetBufferSpaceAttr(alloc.getResult());
+  if (!space || space->getAddressSpace() != AddressSpace::UB)
+    return;
+
+  SmallVector<OpOperand *> writes, incomingUses;
+  if (!collectLoopBufferUses(alloc.getResult(), returned, writes) ||
+      !collectLoopBufferUses(incoming, nullptr, incomingUses))
+    return;
+  // A prior write to the fresh allocation makes it unsafe to reuse the old
+  // value's slot, even if their final consumer supports an in-place result.
+  bool overlap = llvm::any_of(writes, [&](OpOperand *use) {
+    Operation *writer = use->getOwner();
+    auto dps = dyn_cast<DestinationStyleOpInterface>(writer);
+    if (!(dps && dps.isDpsInit(use)) &&
+        !hasEffect<MemoryEffects::Write>(writer, use->get()))
+      return false;
+    return llvm::any_of(incomingUses, [&](OpOperand *incomingUse) {
+      return precedesInScopes(writer, incomingUse->getOwner());
+    });
+  });
+  if (!overlap)
+    return;
+
+  // A new allocation at the backedge can share with the previous iteration:
+  // its only write follows all uses of the incoming value in this iteration.
+  OpBuilder builder(returned->getOwner());
+  auto carry = builder.create<memref::AllocOp>(alloc.getLoc(), alloc.getType());
+  if (!canReuseLoopInit(loop, init)) {
+    auto mark = builder.create<annotation::MarkOp>(alloc.getLoc(), carry);
+    mark->setAttr(HIVMMemoryUniqueAttr::getMnemonic(), builder.getUnitAttr());
+  }
+  if (alloc.getType().getRank() == 0) {
+    // HIVM copy library calls require at least one dimension.
+    Value scalar =
+        builder.create<memref::LoadOp>(alloc.getLoc(), alloc, ValueRange{});
+    builder.create<memref::StoreOp>(alloc.getLoc(), scalar, carry,
+                                    ValueRange{});
+  } else {
+    builder.create<hivm::CopyOp>(alloc.getLoc(), TypeRange{}, alloc.getResult(),
+                                 carry.getResult());
+  }
+  returned->set(carry);
+}

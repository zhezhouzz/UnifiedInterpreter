+// A predicate store writes a full 8- or 16-byte packet even when only
+// a few lanes are active. A short, byte-sized prefix fits in a scalar word.
+static std::optional<unsigned> getShortPredicateBytes(VFMaskedStoreOp store) {
+  if (!store.getVectorType().getElementType().isInteger(1) ||
+      store.getPattern() != StoreDist::NORM_B8)
+    return std::nullopt;
+  int width = getBitWidthFromAttr(store);
+  if (width != 16 && width != 32)
+    return std::nullopt;
+  int64_t lanes;
+  if (auto pge = store.getMask().getDefiningOp<VFPgeOp>()) {
+    if (pge.getPattern() == PgePattern::H && getBitWidthFromAttr(pge) == -1)
+      return std::nullopt;
+    lanes = getNumfromPgePattern(pge);
+  } else if (auto plt = store.getMask().getDefiningOp<VFPltOp>()) {
+    lanes = getConstantIntValue(plt.getTrueShape()).value_or(0);
+  } else {
+    return std::nullopt;
+  }
+  if (lanes <= 0 || lanes > 32 || lanes % util::BITS_PER_BYTE != 0)
+    return std::nullopt;
+  return lanes / util::BITS_PER_BYTE;
+}
+
+// Sum 1 << i for each true lane i. VSHL yields zero for i >= 32.
+// The low bytes of the sum are the dense predicate prefix in memory order.
+static Value packPredicateWord(Value data, int width,
+                               ConversionPatternRewriter &rewriter) {
+  Location loc = data.getLoc();
+  auto wordType = createVLVectorType(rewriter.getI32Type());
+  auto zero = rewriter.create<LLVM::ConstantOp>(loc, rewriter.getI32Type(), 0);
+  auto one = rewriter.create<LLVM::ConstantOp>(loc, rewriter.getI32Type(), 1);
+  if (width == 16)
+    data = buildPunpackOp(loc, zero, data, rewriter)->getResult(0);
+  Value all = buildPgeOp(loc, zero, 32, rewriter)->getResult(0);
+  Value lanes = rewriter.create<VciInstrOp>(loc, wordType, zero, zero);
+  Value ones = rewriter.create<VbrInstrOp>(loc, wordType, one);
+  Value bits = rewriter.create<VshlUXInstrOp>(loc, wordType, ones, lanes, all);
+  Value groups =
+      rewriter.create<VcgaddV2V64U32XInstrOp>(loc, wordType, bits, data);
+  return rewriter.create<VcaddV2V64U32XInstrOp>(loc, wordType, groups);
+}

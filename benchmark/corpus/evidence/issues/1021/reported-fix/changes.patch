+namespace {
+// A supported constant mask is either a true prefix or explicit lane bits.
+struct ConstantMaskInfo {
+  int64_t extent = -1;
+  DenseIntElementsAttr bits;
+};
+} // namespace
+
+static FailureOr<ConstantMaskInfo> getPgeMaskInfo(Value mask) {
+  auto pge = mask ? mask.getDefiningOp<hivmave::VFPgeOp>() : nullptr;
+  if (!pge)
+    return failure();
+  // H depends on the predicate width, which must already be known.
+  if (pge.getPattern() == hivmave::PgePattern::H &&
+      hivmave::getBitWidthFromAttr(pge) == -1)
+    return failure();
+  int64_t extent = hivmave::getNumfromPgePattern(pge);
+  if (extent > cast<VectorType>(mask.getType()).getNumElements())
+    return failure();
+  return ConstantMaskInfo{extent, {}};
+}
+
+// A flat store increments the address once per logical vector lane. A
+// non-unit vector dimension therefore needs the product of the inner vector
+// extents as its physical stride. A dynamic base offset cancels out.
+static bool hasKnownNoncontiguousStoreLanes(vector::TransferWriteOp op) {
+  auto memref = dyn_cast<MemRefType>(op.getSource().getType());
+  VectorType vec = op.getVectorType();
+  if (!memref || memref.getElementType() != vec.getElementType() ||
+      (memref.hasStaticShape() && memref.getNumElements() == 1) ||
+      vec.isScalable())
+    return false;
+
+  SmallVector<int64_t> strides;
+  int64_t offset;
+  if (failed(getStridesAndOffset(memref, strides, offset)))
+    return false;
+  AffineMap map = op.getPermutationMap();
+  auto maskBounds =
+      getMaskBoundsInSourceShape(op.getMask(), op.getMaskType(), map);
+  Value mask = unwrapMaskShapeCasts(op.getMask(), op.getMaskType());
+  if (auto info = getPgeMaskInfo(mask); succeeded(info)) {
+    auto flatMask = cast<VectorType>(mask.getType());
+    auto bounds = reshapeMaskBounds({info->extent}, flatMask.getShape(),
+                                    op.getMaskType().getShape());
+    maskBounds = restoreSourceMaskBounds(map, bounds);
+  }
+  if (llvm::is_contained(maskBounds, 0))
+    return false;
+  int64_t laneStride = 1;
+  for (int64_t dim = vec.getRank() - 1; dim >= 0; --dim) {
+    unsigned sourceDim = map.getDimPosition(dim);
+    int64_t size = vec.getDimSize(dim);
+    int64_t extent = maskBounds.empty() ? size : maskBounds[sourceDim];
+    int64_t stride = strides[sourceDim];
+    if (extent > 1 && !ShapedType::isDynamic(stride) && stride != laneStride)
+      return true;
+    laneStride *= size;
+  }
+  return false;
+}
+
+// VSSTB advances by its configured pitch once per 32-byte block of lanes.
+// Its layout must describe the vector tile as well as the destination view.
+static std::optional<int64_t>
+getTransferWriteBlockStride(vector::TransferWriteOp op) {
+  if (!utils::isTransferWriteSuitForStoreWithStride(op) ||
+      !op.getPermutationMap().isIdentity())
+    return std::nullopt;
+  auto memref = cast<MemRefType>(op.getSource().getType());
+  ArrayRef<int64_t> tile = op.getVectorType().getShape();
+  if (tile.size() != static_cast<size_t>(memref.getRank()) ||
+      tile.front() > hivm::util::BLOCK_NUM_PER_VL ||
+      tile.drop_front() != memref.getShape().drop_front())
+    return std::nullopt;
+
+  SmallVector<int64_t> strides;
+  int64_t offset;
+  if (failed(getStridesAndOffset(memref, strides, offset)))
+    return std::nullopt;
+  int64_t blockLanes = tile.back();
+  int64_t pitch = strides.front();
+  if (strides.back() != 1 || pitch <= 0 || pitch % blockLanes != 0 ||
+      !llvm::isUInt<16>(pitch / blockLanes))
+    return std::nullopt;
+  return pitch;
+}
